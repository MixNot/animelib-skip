{
  "manifest_version": 3,
  "name": "AnimeLib — пропуск видеорекламы",
  "version": "1.1.0",
  "description": "Скрывает рекламные блоки AnimeLib и отключает видеорекламу в Animelib и встроенном Kodik.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://animelib.org/*"],
      "js": ["skip-ads.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://animelib.org/*"],
      "css": ["clean-page.css"],
      "js": ["clean-page.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://kodikplayer.com/*", "https://*.kodikplayer.com/*"],
      "js": ["kodik.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
